<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>M5 Integrated Gate</title>
  </head>
  <body>
    <outline text="M5 Integrated Gate — one pass closes td-39e584" type="task" _status="unchecked">
      <outline text="Build prerequisites" type="task" _status="unchecked">
        <outline text="macOS: current main including the 2026-07-20 edit-key restoration, fresh build" type="task" _status="unchecked"/>
        <outline text="iPhone: real device build" type="task" _status="unchecked" _note="Cable build fine for everything except rename-lag (P5), which ideally also gets a TestFlight/release try."/>
      </outline>
      <outline text="Sitting 1 — macOS (~25 min)" type="task" _status="unchecked">
        <outline text="A. Checkbox &amp; filter flow" type="task" _status="unchecked">
          <outline text="Create list; add 5 items, 2-3 levels of nesting" type="task" _status="unchecked"/>
          <outline text="Check a leaf" type="task" _status="unchecked" _note="Strikethrough appears; parent shows progress (e.g. 1/3)."/>
          <outline text="Click a parent's checkbox" type="task" _status="unchecked" _note="Whole branch checks."/>
          <outline text="Make a mixed parent" type="task" _status="unchecked" _note="Some children checked → orange minus tri-state."/>
          <outline text="Cycle filters: Remaining / Completed / All" type="task" _status="unchecked" _note="Remaining hides checked; Completed shows only checked; All shows everything."/>
          <outline text="Under Remaining, check a visible row" type="task" _status="unchecked" _note="Row animates out; selection advances to the next visible row."/>
          <outline text="Check everything under Remaining" type="task" _status="unchecked" _note="All Done! screen → Show All returns."/>
          <outline text="Right-click parent → Reset Branch… → confirm" type="task" _status="unchecked" _note="Branch unchecked."/>
          <outline text="Toolbar Reset All… → confirm" type="task" _status="unchecked" _note="All unchecked."/>
          <outline text="Cmd-Z back through every mutation above" type="task" _status="unchecked" _note="Each one undoes cleanly."/>
          <outline text="Quit and relaunch" type="task" _status="unchecked" _note="Everything persisted; legend window did NOT auto-reopen."/>
          <outline text="Remnant sweep: no 'Check Mode' wording anywhere" type="task" _status="unchecked" _note="Toolbar, menus, Help, AND Settings."/>
        </outline>
        <outline text="B. Keyboard-only session (mouse untouched)" type="task" _status="unchecked">
          <outline text="Shift-Cmd-N creates a list from the keyboard" type="task" _status="unchecked"/>
          <outline text="Return on a selected row arms the add field directly below — try ~10 different rows" type="task" _status="unchecked" _note="Restored primary add path (2026-07-20), never touches the menu system. Cursor must be live and typing land instantly EVERY time. Then: type → Return → type → Return ×3 → Esc ends the flow."/>
          <outline text="Shift-Return inserts 'New Item' above, already renaming — try ~5" type="task" _status="unchecked" _note="Typing replaces the placeholder; Return commits."/>
          <outline text="Cmd-Return arms an indented child add field, cursor live — try ~5" type="task" _status="unchecked"/>
          <outline text="Same three adds via menus: Cmd-N, Opt-Cmd-N, and Item menu clicked with the mouse" type="task" _status="unchecked" _note="Identical behavior including live cursor (menu-path machinery)."/>
          <outline text="Arrows move selection; Shift-arrows extend" type="task" _status="unchecked"/>
          <outline text="Cmd-E (and double-click) renames in place; Esc cancels, Return commits" type="task" _status="unchecked" _note="Esc leaves title unchanged."/>
          <outline text="Remaining filter → select top row → Space Space Space" type="task" _status="unchecked" _note="Rows vanish; selection advances each time."/>
          <outline text="Shift-extend a multi-selection → Cmd-K immediately" type="task" _status="unchecked" _note="ALL highlighted rows toggle — never just the last row (the old B3 bug)."/>
          <outline text="Tab / Shift-Tab, Cmd-] / Cmd-[, Cmd-Opt-Up/Down" type="task" _status="unchecked" _note="Indent, outdent, move — all act on the highlighted row."/>
          <outline text="Cmd-Delete → confirmation → press Return" type="task" _status="unchecked" _note="Return activates Delete (the dialog default), never adds an item."/>
          <outline text="Cmd-Z back through everything" type="task" _status="unchecked"/>
          <outline text="Edge: Return, nothing selected, empty list" type="task" _status="unchecked" _note="Arms the root add field."/>
          <outline text="Edge: Return with a multi-selection" type="task" _status="unchecked" _note="Does nothing."/>
          <outline text="Edge: Space while renaming/adding, then again after Return/Esc" type="task" _status="unchecked" _note="During text entry: types a space, never toggles. After entry ends: toggles the selected row (2026-07-20 decision — this convenience is a keeper; verify both halves)."/>
          <outline text="Edge: click sidebar search, press Space" type="task" _status="unchecked" _note="Types a space; editor untouched."/>
          <outline text="Edge: Space with no selection" type="task" _status="unchecked" _note="List scrolls (native default)."/>
          <outline text="Esc with no text entry active" type="task" _status="unchecked" _note="Clears selection; a second Esc does nothing."/>
        </outline>
        <outline text="C. Consistency audit" type="task" _status="unchecked">
          <outline text="Read Help's Mac keyboard section line by line, performing each entry" type="task" _status="unchecked" _note="Any line that doesn't match reality = fail."/>
          <outline text="Audit each surface against docs/m5-parity-matrix.md" type="task" _status="unchecked" _note="Item menu; View menu (Filter submenu, Keyboard Legend); row right-click (hints ON); row ellipsis (hints OFF — deliberate); toolbar Actions; empty-area right-click (Add Item, Expand All, Collapse All)."/>
          <outline text="Press every advertised shortcut once" type="task" _status="unchecked" _note="Return, Shift-Return, Cmd-N, Shift-Cmd-N, Opt-Cmd-N, Cmd-Return, Cmd-E, Cmd-K, Cmd-], Cmd-[, Cmd-Opt-Up, Cmd-Opt-Down, Cmd-Delete, Opt-Cmd-1/2/3, Opt-Cmd-I, Opt-Cmd-L, Cmd-?, Cmd-comma, Cmd-Z, Shift-Cmd-Z."/>
        </outline>
        <outline text="D. New features" type="task" _status="unchecked">
          <outline text="Inspector notes stay bounded" type="task" _status="unchecked" _note="Paste ~15 lines → field stays ~3-6 lines tall, scrolls internally; inspector layout intact."/>
          <outline text="Keyboard Legend: Opt-Cmd-L opens; keys light up; hides again" type="task" _status="unchecked" _note="Press Return/Space/Tab/Cmd-K/arrows in the editor → matching row flashes ~1s."/>
          <outline text="Legend never steals focus" type="task" _status="unchecked" _note="With legend open, keep typing — keystrokes stay in the editor."/>
        </outline>
        <outline text="E. Judgment calls (verdicts, not pass/fail)" type="task" _status="unchecked">
          <outline text="Row menus say 'New Item' where they said 'Add Below' — keep or revert?" type="task" _status="unchecked"/>
          <outline text="Strikethrough on checked rows — keep?" type="task" _status="unchecked"/>
          <outline text="Instant hide under Remaining vs a grace delay — keep?" type="task" _status="unchecked"/>
          <outline text="Overall: does it feel like the prototype? Note anything missing." type="task" _status="unchecked"/>
        </outline>
      </outline>
      <outline text="Sitting 2 — iPhone, real device (~15 min)" type="task" _status="unchecked">
        <outline text="P. Core flow" type="task" _status="unchecked">
          <outline text="Add 5 nested items — add field appears AT the insertion point" type="task" _status="unchecked" _note="Below its anchor, indented for a child. Bottom-of-list = spec violation."/>
          <outline text="Keyboard-dismiss button (down-chevron)" type="task" _status="unchecked" _note="Keyboard drops, add flow stays armed with draft; tap field → keyboard returns; Done ends flow."/>
          <outline text="Checkbox flow: leaf, branch, mixed, filters, All Done, Reset" type="task" _status="unchecked" _note="Fat-finger check: checkbox vs chevron never mis-tap."/>
          <outline text="Undo/Redo in toolbar overflow" type="task" _status="unchecked" _note="Mutate → Undo on / Redo off; Undo → Redo on; Redo; switch lists → both off."/>
          <outline text="Rename lag measurement (td-e7c609)" type="task" _status="unchecked" _note="Type a quick sentence in rename. Record build type (cable vs TestFlight) and verdict: none / noticeable / bad. Non-blocking today; fix-before-ship regardless."/>
          <outline text="Double-tap a row opens Details; single-tap not delayed" type="task" _status="unchecked"/>
          <outline text="Details notes bounded and scrolls internally" type="task" _status="unchecked" _note="Paste long text."/>
          <outline text="Scroll hard to top: no shake, large title renders" type="task" _status="unchecked" _note="td-ef3eec probe — if it still shakes, note it; known issue, just record."/>
        </outline>
        <outline text="Q. Gestures never verified on hardware" type="task" _status="unchecked">
          <outline text="Drag a row among its siblings" type="task" _status="unchecked" _note="Clean same-parent reorder."/>
          <outline text="Drag past first/last sibling" type="task" _status="unchecked" _note="Clamps sanely; no crash or jump."/>
          <outline text="Long-press: menu vs drag arbitration" type="task" _status="unchecked" _note="td-3960b2 said drag only worked by sliding out of the menu — record what happens now."/>
          <outline text="Swipe-to-delete → confirm → Undo restores" type="task" _status="unchecked"/>
          <outline text="Kill and relaunch — everything persisted" type="task" _status="unchecked"/>
        </outline>
      </outline>
      <outline text="Wrap-up" type="task" _status="unchecked">
        <outline text="Hand CC2 the marked-up list (any form)" type="task" _status="unchecked" _note="Fails → td issues from one-line symptoms. Judgment calls → recorded decisions. All pass or signed deferrals → td-39e584 closes; next stop TestFlight dogfood."/>
      </outline>
    </outline>
  </body>
</opml>
