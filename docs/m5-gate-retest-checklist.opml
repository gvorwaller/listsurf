        <outline text="Delete advances selection" type="task" _status="unchecked" _note="Cmd-Delete + Return on middle row → row below selected, arrows stay in editor; last row → previous selected; Cmd-Z restores row AND selection."/>
        <outline text="Second Esc does nothing" type="task" _status="unchecked" _note="Esc clears selection; second Esc: sidebar untouched."/>
        <outline text="Cmd-O Edit Notes" type="task" _status="unchecked" _note="Select row → Cmd-O → type immediately, lands in Notes; Opt-Cmd-I close → Down moves editor selection. Cmd-O listed in View menu, Help, Legend."/>
        <outline text="Multi-select Tab/Shift-Tab/Cmd-Opt-arrows" type="task" _status="unchecked" _note="3 siblings: indent/outdent/move preserve order, ONE Cmd-Z per op restores all. Include first sibling + Tab → nothing moves (all-or-nothing)."/>
