        <outline text="Relaunch restores last list" type="task" _status="unchecked"/>
        <outline text="Per-list view state survives switch AND relaunch (td-5d405a)" type="task" _status="unchecked" _note="Expand nested branch + Remaining filter → switch lists → back: expanded, filtered, selection intact. Quit → relaunch: same. THE checkoff-workflow fix."/>
